{
  "expo": {
    "name": "Northform",
    "slug": "northform-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/northform-icon.png",
    "scheme": "northformapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "android": {
      "package": "com.shah.northform",
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/images/northform-adaptive-foreground.png",
        "monochromeImage": "./assets/images/northform-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/northform-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E10",
          "image": "./assets/images/northform-splash.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "525c32a5-52c9-4b70-a4ca-144bc1f0e10d"
      }
    },
    "owner": "shahisl"
  }
}
